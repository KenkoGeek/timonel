{
  "name": "timonel",
  "type": "module",
  "version": "3.1.1",
  "description": "Timonel: programmatic Helm chart generator using cdk8s (TypeScript)",
  "bin": {
    "timonel": "dist/cli.js",
    "tl": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/helm": {
      "types": "./dist/lib/helm.d.ts",
      "import": "./dist/lib/helm.js",
      "default": "./dist/lib/helm.js"
    },
    "./lib/utils/helmControlStructures": {
      "types": "./dist/lib/utils/helmControlStructures.d.ts",
      "import": "./dist/lib/utils/helmControlStructures.js",
      "default": "./dist/lib/utils/helmControlStructures.js"
    },
    "./lib/utils/logger": {
      "types": "./dist/lib/utils/logger.d.ts",
      "import": "./dist/lib/utils/logger.js",
      "default": "./dist/lib/utils/logger.js"
    },
    "./lib/utils/helmYamlSerializer": {
      "types": "./dist/lib/utils/helmYamlSerializer.d.ts",
      "import": "./dist/lib/utils/helmYamlSerializer.js",
      "default": "./dist/lib/utils/helmYamlSerializer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsc -w -p tsconfig.json",
    "prepare": "husky",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:lint": "eslint .",
    "security:audit": "pnpm audit --audit-level=high",
    "security:check": "pnpm run security:lint && pnpm run security:audit",
    "deps:check": "pnpm outdated",
    "deps:update": "pnpm update --latest",
    "md:lint": "markdownlint \"**/*.md\"",
    "md:fix": "markdownlint --fix \"**/*.md\"",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude tests/performance-benchmarks.test.ts",
    "doc:coverage": "tsx scripts/project-doc-coverage.ts",
    "doc:coverage:validate": "tsx scripts/validate-doc-coverage.ts",
    "ci:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "version:patch": "npm version patch && echo 'Remember to update CHANGELOG.md'",
    "version:minor": "npm version minor && echo 'Remember to update CHANGELOG.md'",
    "version:major": "npm version major && echo 'Remember to update CHANGELOG.md'"
  },
  "keywords": [
    "helm",
    "charts",
    "cdk8s",
    "kubernetes",
    "iac"
  ],
  "author": "Franklin García <KenkoGeek>",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenkoGeek/timonel.git"
  },
  "bugs": {
    "url": "https://github.com/KenkoGeek/timonel/issues"
  },
  "homepage": "https://github.com/KenkoGeek/timonel#readme",
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,cjs,json,yml,yaml}": [
      "prettier --write"
    ],
    "**/*.md": [
      "markdownlint --fix"
    ]
  },
  "dependencies": {
    "cdk8s": "^2.70.100",
    "cdk8s-plus-33": "^2.5.53",
    "constructs": "^10.8.1",
    "handlebars": "^4.7.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint": "^0.41.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
